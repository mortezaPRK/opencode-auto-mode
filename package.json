{
  "name": "@mortz.prk/opencode-auto-mode",
  "version": "1.0.2",
  "description": "Configurable automatic permission review for OpenCode v2.",
  "author": {
    "name": "Andrew Mellen",
    "url": "https://github.com/mellena1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mortezaPRK/opencode-auto-mode.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "src",
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./tui": {
      "import": "./src/tui.tsx",
      "types": "./src/tui.tsx"
    },
    "./rpc": {
      "import": "./src/rpc.ts",
      "types": "./src/rpc.ts"
    },
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:integration": "bun run integration/opencode.ts",
    "build:gui": "vite build",
    "prepublishOnly": "bun run build:gui"
  },
  "dependencies": {
    "@opencode/ai": "2.1.3",
    "@opencode/plugin": "2.2.0",
    "@opencode/schema": "2.2.0",
    "effect": "4.0.1",
    "shell-quote": "1.12.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opencode/theme": "2.2.0",
    "@opentui/core": "0.7.0",
    "@opentui/keymap": "^0.6.6",
    "@opentui/solid": "0.7.0",
    "@types/node": "^26.6.4",
    "@types/shell-quote": "1.7.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "solid-js": "1.9.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0"
  }
}
