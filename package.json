{
  "name": "@mortz.prk/opencode-auto-mode",
  "version": "0.1.2",
  "description": "Configurable automatic permission review for OpenCode v2.",
  "author": {
    "name": "Andrew Mellen",
    "url": "https://github.com/mellena1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mortezaPRK/opencode-auto-mode.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "type": "module",
  "license": "MIT",
  "files": ["src"],
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./tui": {
      "import": "./src/tui.tsx",
      "types": "./src/tui.tsx"
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:integration": "bun run integration/opencode.ts"
  },
  "dependencies": {
    "@bufbuild/cel": "0.6.1",
    "@bufbuild/protobuf": "2.16.0",
    "@opencode/plugin": "^2.0.14",
    "shell-quote": "1.12.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opencode/theme": "^2.0.14",
    "@opentui/core": "0.5.17",
    "@opentui/keymap": "^0.5.10",
    "@opentui/solid": "0.5.17",
    "@types/node": "^26.6.4",
    "@types/shell-quote": "1.7.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "solid-js": "1.9.17",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1"
  }
}
